<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_invoice_tree_paid_status" model="ir.ui.view">
        <field name="name">account.invoice.tree.paid.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="payment_status"
                       decoration-success="payment_status == 'Paid'"
                       decoration-warning="payment_status == 'Partial'"
                       decoration-danger="payment_status == 'Unpaid'"
                       widget="badge"
                       optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_account_invoice_tree_paid_status_purchase" model="ir.ui.view">
        <field name="name">account.invoice.tree.paid.status.purchase</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoices_tree_purchase"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="payment_status"
                       decoration-success="payment_status == 'Paid'"
                       decoration-warning="payment_status == 'Partial'"
                       decoration-danger="payment_status == 'Unpaid'"
                       widget="badge"
                       optional="show"/>
            </field>
        </field>
    </record>
</odoo>
