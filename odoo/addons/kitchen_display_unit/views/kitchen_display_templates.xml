<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="kitchen_display_page" name="Kitchen Display">
        &lt;!DOCTYPE html&gt;
        <html>
            <head>
                <title>Kitchen Display - Al Garshoub</title>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <link rel="stylesheet" href="/kitchen_display_unit/static/src/css/kitchen_display.css"/>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
            </head>
            <body class="bg-dark text-light">
                <div class="container-fluid p-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="text-warning m-0">
                            <i class="fa fa-cutlery"/> Kitchen Display - Al Garshoub
                        </h2>
                        <div>
                            <span class="badge bg-secondary" id="last-updated">Last updated: Just now</span>
                            <button class="btn btn-sm btn-outline-light ms-2" onclick="toggleSound()">
                                <i class="fa fa-volume-up" id="sound-icon"/> Sound ON
                            </button>
                        </div>
                    </div>
                    <div class="row" id="orders-container">
                        <div class="col-12 text-center text-muted py-5">
                            <h4>Loading orders...</h4>
                        </div>
                    </div>
                </div>

                <audio id="new-order-sound" preload="auto">
                    <source src="/kitchen_display_unit/static/src/sounds/notification.mp3" type="audio/mpeg"/>
                </audio>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                <script src="/kitchen_display_unit/static/src/js/kitchen_display.js"></script>
            </body>
        </html>
    </template>
</odoo>
