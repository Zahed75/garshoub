<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- LC Reference Sequence -->
        <record id="seq_letter_of_credit" model="ir.sequence">
            <field name="name">Letter of Credit</field>
            <field name="code">letter.of.credit</field>
            <field name="prefix">LC-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- NBR Demo Partner -->
        <record id="partner_nbr_bangladesh" model="res.partner">
            <field name="name">National Board of Revenue (NBR)</field>
            <field name="is_company">True</field>
            <field name="is_nbr">True</field>
            <field name="country_id" ref="base.bd"/>
            <field name="comment">Bangladesh NBR — All customs duties must be billed to this partner.</field>
        </record>

        <!-- Daily cron for certificate expiry — Odoo 19 compatible -->
        <record id="cron_lc_certificate_expiry" model="ir.cron">
            <field name="name">LC — Check IRC/ERC Certificate Expiry</field>
            <field name="model_id" ref="lc_management.model_letter_of_credit"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_certificate_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
