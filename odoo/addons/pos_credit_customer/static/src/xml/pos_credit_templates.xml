<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_credit_customer.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]/div[1]" position="before">
            <div class="paymentmode-toggle mb-2">
                <button class="btn btn-lg w-100"
                        t-att-class="paymentMode === 'credit' ? 'btn-warning' : 'btn-success'"
                        t-on-click="togglePaymentMode">
                    <t t-if="paymentMode === 'cash'">
                        <i class="fa fa-money"/> Cash Sale
                    </t>
                    <t t-else="">
                        <i class="fa fa-credit-card"/> Credit Sale
                    </t>
                </button>
            </div>
        </xpath>
    </t>

    <t t-name="pos_credit_customer.CustomerHistoryPanel">
        <div class="customer-history-panel p-3 bg-light border rounded">
            <h5><i class="fa fa-history"/> Customer History</h5>
            <div t-if="props.partner">
                <div class="mb-2">
                    <strong>Credit Limit:</strong>
                    <span t-esc="env.utils.formatCurrency(props.partner.credit_limit || 0)"/>
                </div>
                <div class="mb-2">
                    <strong>Current Balance:</strong>
                    <span t-esc="env.utils.formatCurrency(props.partner.current_balance || 0)"
                          t-att-class="props.partner.current_balance > 0 ? 'text-danger' : 'text-success'"/>
                </div>
                <div class="mb-2">
                    <strong>Available Credit:</strong>
                    <span t-esc="env.utils.formatCurrency(props.partner.available_credit || 0)"
                          t-att-class="(props.partner.available_credit || 0) < 0 ? 'text-danger' : 'text-success'"/>
                </div>
                <hr/>
                <h6>Recent Orders</h6>
                <div t-if="props.orders and props.orders.length > 0">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Ref</th>
                                <th>Date</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="props.orders" t-as="order" t-key="order.id">
                                <td t-esc="order.name"/>
                                <td t-esc="order.date_order"/>
                                <td t-esc="env.utils.formatCurrency(order.amount_total)"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-else="" class="text-muted">
                    No recent orders found.
                </div>
            </div>
        </div>
    </t>

</templates>
