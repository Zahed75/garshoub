<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_pos_form_credit" model="ir.ui.view">
        <field name="name">pos.order.form.credit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <field name="session_id" position="after">
                <field name="payment_mode" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="view_pos_order_tree_credit" model="ir.ui.view">
        <field name="name">pos.order.tree.credit</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="payment_mode" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
