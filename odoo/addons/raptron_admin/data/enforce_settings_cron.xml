<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Safety-net cron job that enforces our custom settings periodically.
        This runs every 5 minutes to ensure the login page, favicon, and
        admin credentials are not overridden by other modules.
    -->
    <record id="ir_cron_enforce_garshoub_settings" model="ir.cron">
        <field name="name">Garshoub: Enforce Login Branding &amp; Admin Credentials</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_enforce_garshoub_settings()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
