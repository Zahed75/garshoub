<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="admin_portal_template" name="Admin Portal">
        &lt;!DOCTYPE html&gt;
        <html>
            <head>
                <title>Raptro SaaS Admin</title>
                <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
           
                <style>
                    body {
                        background: radial-gradient(circle at top right, #EEF2FF 0%, #F8FAFC 100%);
                        font-family: 'Inter', -apple-system, sans-serif;
                        color: #1E293B;
                        min-height: 100vh;
                        display: flex;
                        align-items: center;
                    }
                    .admin-card {
                        background-color: #FFFFFF;
                        border-radius: 24px;
                        border: 1px solid rgba(226, 232, 240, 0.8);
                        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.05);
                        overflow: hidden;
                    }
                    .admin-header {
                        background-color: #FFFFFF;
                        padding: 2rem 2rem 1rem 2rem;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                    }
                    .admin-title {
                        color: #0F172A;
                        font-weight: 800;
                        font-size: 1.5rem;
                        letter-spacing: -0.025em;
                        margin-top: 0.5rem;
                    }
                    .btn-primary {
                        background: linear-gradient(135deg, #4F46E5, #8B5CF6);
                        border: none;
                        font-weight: 600;
                        padding: 0.75rem 1.5rem;
                        letter-spacing: 0.3px;
                        border-radius: 8px;
                        transition: all 0.3s ease;
                    }
                    .btn-primary:hover {
                        background: linear-gradient(135deg, #4338CA, #7C3AED);
                        transform: translateY(-1px);
                        box-shadow: 0 8px 20px -6px rgba(139, 92, 246, 0.6);
                    }
                    .form-control {
                        background-color: #FFFFFF;
                        border: 1px solid #CBD5E1;
                        color: #0F172A;
                        border-radius: 8px;
                        padding: 0.75rem 1rem;
                    }
                    .form-control:focus {
                        background-color: #FFFFFF;
                        border-color: #8B5CF6;
                        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
                        color: #0F172A;
                    }
                    .form-control::placeholder {
                        color: #94A3B8;
                    }
                    .form-label {
                        font-weight: 600;
                        color: #334155;
                        font-size: 0.875rem;
                        margin-bottom: 0.5rem;
                        display: block;
                    }
                    .logo-img {
                        height: 120px;
                        width: 120px;
                        max-width: 100%;
                        object-fit: contain;
                        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.02));
                    }
                </style>
            </head>
            <body>
                <div class="container w-100">
                    <div class="row justify-content-center">
                        <div class="col-md-6">
                            
                            <t t-if="success_msg">
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <t t-out="success_msg"/>
                                </div>
                            </t>
                            
                            <t t-if="error_msg">
                                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                    <t t-out="error_msg"/>
                                </div>
                            </t>

                            <div class="card admin-card">
                                <div class="card-header admin-header text-center">
                                    <img src="/saas_practice/logo/RaptroLogo.png" class="logo-img" alt="Raptro Logo"/>
                                    <h4 class="mb-0 admin-title">Create Client Database</h4>
                                </div>
                                <div class="card-body p-5 pt-4">
                                    <form action="/admin/create_db" method="POST">
                                        
                                        <div class="form-group mb-4">
                                            <label for="company_name" class="form-label">Database / Company Name</label>
                                            <input type="text" class="form-control" name="company_name" required="required" placeholder="e.g. client1_db"/>
                                            <small class="form-text text-muted mt-2">Use standard characters, no spaces.</small>
                                        </div>
                                        
                                        <div class="form-group mb-4">
                                            <label for="email" class="form-label">Client Admin Email</label>
                                            <input type="email" class="form-control" name="email" required="required" placeholder="admin@client.com"/>
                                        </div>
                                        
                                        <div class="form-group mb-5">
                                            <label for="password" class="form-label">Client Admin Password</label>
                                            <input type="password" class="form-control" name="password" required="required" placeholder="••••••••"/>
                                        </div>
                                        
                                        <button type="submit" class="btn btn-primary btn-block">Spin up Database</button>
                                        
                                    </form>
                                </div>
                                <div class="card-footer text-center border-0 pb-4" style="background-color: transparent;">
                                    <small style="color: #64748B;">Logged in as master admin. <a href="/web/session/logout" style="color: #8B5CF6; font-weight: 500; text-decoration: none;">Log out</a></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
