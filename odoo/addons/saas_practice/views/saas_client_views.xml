<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_saas_client_tree" model="ir.ui.view">
        <field name="name">saas.client.list</field>
        <field name="model">saas.client</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="database_name"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_saas_client_form" model="ir.ui.view">
        <field name="name">saas.client.form</field>
        <field name="model">saas.client</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="create_database" string="Create Database" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="database_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_saas_client" model="ir.actions.act_window">
        <field name="name">SaaS Clients</field>
        <field name="res_model">saas.client</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_saas_root" name="SaaS Management"/>
    <menuitem id="menu_saas_client" name="Clients" parent="menu_saas_root" action="action_saas_client"/>
</odoo>
