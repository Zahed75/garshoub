<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_send_whatsapp"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp"
                        invisible="move_type != 'out_invoice'">
                    <field name="whatsapp_sent" invisible="1"/>
                    <span invisible="whatsapp_sent">Send WhatsApp</span>
                    <span invisible="not whatsapp_sent">WhatsApp Sent</span>
                </button>
            </div>
        </field>
    </record>
</odoo>
