<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='default_taxes_setting_container']" position="after">
                <block title="WhatsApp Integration" name="whatsapp_integration">
                    <setting string="WhatsApp API Token" help="Your Meta WhatsApp Cloud API token">
                        <field name="whatsapp_api_token" password="True"/>
                    </setting>
                    <setting string="Phone Number ID" help="Your WhatsApp Business phone number ID">
                        <field name="whatsapp_phone_number_id"/>
                    </setting>
                    <setting string="Business Account ID" help="Your Meta Business Account ID">
                        <field name="whatsapp_business_account_id"/>
                    </setting>
                    <setting string="API Version" help="WhatsApp Graph API version (e.g. v18.0)">
                        <field name="whatsapp_api_version"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
